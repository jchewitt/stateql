{
  "name": "@launch-echo/stateql-graphql",
  "version": "0.1.0-alpha.0",
  "type": "module",
  "license": "MIT",
  "description": "GraphQL definitions, operation planning and HTTP acquisition for StateQL.",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./codegen": {
      "types": "./dist/codegen.d.ts",
      "import": "./dist/codegen.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs graphql",
    "prepack": "pnpm --silent run build",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "prepublishOnly": "node ../../scripts/publish-from-artifacts-only.mjs"
  },
  "dependencies": {
    "@launch-echo/stateql-core": "workspace:*"
  },
  "peerDependencies": {
    "graphql": "^16.14.2"
  },
  "devDependencies": {
    "graphql": "16.14.2",
    "tsx": "4.23.15",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  },
  "author": "Jon Hewitt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jchewitt/stateql.git",
    "directory": "packages/graphql"
  },
  "homepage": "https://github.com/jchewitt/stateql#readme",
  "bugs": {
    "url": "https://github.com/jchewitt/stateql/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "next"
  },
  "sideEffects": false,
  "types": "./dist/index.d.ts"
}
