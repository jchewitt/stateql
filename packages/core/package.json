{
  "name": "@tandrove/core",
  "version": "1.0.0-alpha.6",
  "description": "Framework-independent Tandrove shared-state runtime and selective refresh contracts.",
  "type": "module",
  "license": "MIT",
  "author": "Jon Hewitt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jchewitt/tandrove.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/jchewitt/tandrove#readme",
  "bugs": {
    "url": "https://github.com/jchewitt/tandrove/issues"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "next"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "build": "node ../../scripts/build-package.mjs core",
    "prepack": "pnpm --silent run build",
    "prepublishOnly": "node ../../scripts/publish-from-artifacts-only.mjs"
  }
}
