{
  "name": "tandrove-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "tsc --project tsconfig.typecheck.json && tsc --project tsconfig.browser.json && pnpm -r --if-present typecheck",
    "test": "node --test tests/release.test.mjs tests/release-automation.test.mjs tests/workspace.test.mjs && pnpm -r --if-present test",
    "demo": "pnpm --parallel --filter @tandrove-demo/billing-* dev",
    "demo:planner": "pnpm --filter @tandrove-demo/query-planner demo",
    "demo:store": "pnpm --filter @tandrove-demo/query-planner demo:store",
    "demo:acquire": "tsx scripts/acquisition-demo.ts",
    "demo:vanilla": "pnpm --filter @tandrove-demo/vanilla demo",
    "demo:adapters": "pnpm --filter @tandrove-demo/vanilla demo:adapters",
    "demo:providers": "pnpm --filter @tandrove-demo/vanilla demo:providers",
    "demo:polling": "pnpm --filter @tandrove-demo/vanilla demo:polling",
    "demo:retention": "pnpm --filter @tandrove-demo/vanilla demo:retention",
    "demo:freshness": "pnpm --filter @tandrove-demo/vanilla demo:freshness",
    "demo:deadline": "pnpm --filter @tandrove-demo/vanilla demo:deadline",
    "demo:typescript": "pnpm --filter @tandrove-demo/vanilla demo:typescript",
    "generate:billing": "pnpm --filter @tandrove/graphql... build && tsx scripts/generate-billing.ts",
    "generate:check": "tsx scripts/generate-billing.ts --check",
    "test:browser": "playwright test",
    "compare": "pnpm --filter @tandrove/angular... --filter @tandrove/graphql... build && tsx apps/billing-demo/bench/compare.mjs",
    "measure:readiness": "pnpm --filter @tandrove/graphql... build && node apps/billing-demo/bench/readiness.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pack:check": "node scripts/check-package.mjs",
    "check": "pnpm format:check && pnpm build && pnpm generate:check && pnpm typecheck && pnpm test && pnpm pack:check",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "release:check": "node scripts/check-release.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:bootstrap": "node scripts/publish-release.mjs --bootstrap",
    "release:publish": "node scripts/publish-release.mjs",
    "release:verify": "node scripts/publish-release.mjs --verify",
    "version:release": "node scripts/version-release.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "2.29.8",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "prettier": "3.9.10",
    "semver": "7.7.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "yaml": "2.8.1"
  }
}
