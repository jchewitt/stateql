{
  "name": "stateql-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "tsc --project tsconfig.typecheck.json && tsc --project tsconfig.browser.json && pnpm -r --if-present typecheck",
    "test": "node --test tests/release.test.mjs tests/workspace.test.mjs && pnpm -r --if-present test",
    "demo": "pnpm --parallel --filter @stateql-demo/billing-* dev",
    "demo:planner": "pnpm --filter @stateql-demo/query-planner demo",
    "demo:store": "pnpm --filter @stateql-demo/query-planner demo:store",
    "generate:billing": "pnpm --filter @jchewitt/stateql-graphql... build && tsx scripts/generate-billing.ts",
    "generate:check": "tsx scripts/generate-billing.ts --check",
    "test:browser": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pack:check": "node scripts/check-package.mjs",
    "check": "pnpm format:check && pnpm build && pnpm generate:check && pnpm typecheck && pnpm test && pnpm pack:check",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "release:check": "node scripts/check-release.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "2.29.8",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "prettier": "3.9.10",
    "semver": "7.7.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "yaml": "2.8.1"
  }
}
