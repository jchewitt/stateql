    "@angular/platform-browser": "21.2.25",
    "@apollo/client": "4.3.4",
    "@tandrove/angular": "workspace:*",
    "@tandrove/core": "workspace:*",
    "@tandrove/graphql": "workspace:*",
    "apollo-angular": "14.2.0",
    "graphql": "16.14.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.27",
    "@angular/cli": "21.2.27",
    "@angular/compiler-cli": "21.2.25",
    "@types/node": "22.20.5",
    "esbuild": "0.28.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
