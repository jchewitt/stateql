{
  "name": "@tandrove-demo/billing-demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @tandrove/angular... --filter @tandrove/graphql... build && ng serve --host 127.0.0.1 --port 4200",
